{% capture footer_contents %}
  <div class="footer-identity">&copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}.</div>
  <div class="footer-links">
    {% include social.liquid %}
    <a href="{{ '/cv/' | relative_url }}" title="CV"><i class="fa-solid fa-file-arrow-down"></i></a>
    <span class="footer-demo">Demo links</span>
  </div>
  <div class="footer-credit">{{ site.footer_text }}</div>
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container research-footer">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
