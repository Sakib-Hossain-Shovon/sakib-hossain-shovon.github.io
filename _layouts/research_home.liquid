---
layout: default
---
<div class="research-home">
  <section class="research-hero">
    <div class="row align-items-center">
      <div class="col-lg-8 order-2 order-lg-1">
        <div class="eyebrow">Statistical Artificial Intelligence Lab · KAIST AI</div>
        <h1 class="hero-title">Md Sakib Hossain Shovon</h1>
        <p class="hero-subtitle">Researcher &amp; M.S. Student in Artificial Intelligence at KAIST</p>
        <p class="hero-copy">
          I am a graduate researcher at the Statistical Artificial Intelligence Lab (SAIL), KAIST AI, advised by
          <a href="https://sail.kaist.ac.kr/en/members/jaesik">Prof. Jaesik Choi</a>. My research focuses on
          <strong>diffusion and flow matching</strong>, <strong>physical AI and world models</strong>, <strong>3D vision</strong>,
          <strong>explainable AI</strong>, inference optimization, and multimodal foundation models.
        </p>
        <div class="hero-actions" aria-label="Professional links">
          <a class="hero-button primary" href="mailto:sakib@kaist.ac.kr"><i class="fa-solid fa-envelope"></i>Email</a>
          <a class="hero-button" href="https://scholar.google.com/citations?user=9VM2SHYAAAAJ"><i class="ai ai-google-scholar"></i>Google Scholar</a>
          <a class="hero-button" href="https://github.com/Sakib-Hossain-Shovon"><i class="fa-brands fa-github"></i>GitHub</a>
          <a class="hero-button" href="https://www.linkedin.com/in/md-sakib-hossain-shovon-601738178/"
            ><i class="fa-brands fa-linkedin"></i>LinkedIn</a
          >
          <a class="hero-button" href="{{ '/cv/' | relative_url }}"><i class="fa-solid fa-file-arrow-down"></i>CV</a>
        </div>
      </div>
      <div class="col-lg-4 order-1 order-lg-2 text-center">
        {% include figure.liquid loading="eager" path="assets/img/sakib_githubio.jpg" class="hero-photo" sizes="300px" alt="Portrait of Md Sakib Hossain Shovon" cache_bust=true %}
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="row">
      <div class="col-lg-9">
        <div class="eyebrow">About</div>
        <h2 class="section-heading">Improving the representations, controllability, and reasoning of visual AI.</h2>
        <p class="hero-copy">
          Before joining KAIST, I earned a B.Sc. in Computer Science and Engineering from American International University-Bangladesh. My research
          experience includes collaborations with The University of Queensland and Qatar University. I am also the Co-Founder &amp; CEO of
          <a href="https://neurontree.ai/founders-sakib/">NeuronTreeAI</a>, a nonprofit initiative for AI education, research mentorship, and
          accessible advanced research knowledge.
        </p>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="eyebrow">Selected research</div>
    <h2 class="section-heading">Research projects</h2>
    <p class="section-lead">Current and prior applied research initiatives.</p>
    <div class="row">
      {% assign featured_projects = site.projects | where: 'featured', true | sort: 'importance' %}
      {% for project in featured_projects %}
        <div class="col-md-6 mb-4">
          <article class="research-card">
            <a href="{{ project.url | relative_url }}">{% include figure.liquid path=project.img class="mb-0" sizes="540px" alt=project.title %}</a>
            <div class="research-card-body">
              <h3>{{ project.title }}</h3>
              <p>{{ project.description }}</p>
              <div class="project-links">
                <a href="{{ project.url | relative_url }}">Project <i class="fa-solid fa-arrow-right"></i></a>
              </div>
            </div>
          </article>
        </div>
      {% endfor %}
    </div>
    <a class="hero-button" href="{{ '/projects/' | relative_url }}">View all projects <i class="fa-solid fa-arrow-right"></i></a>
  </section>

  <section class="home-section">
    <div class="eyebrow">Research at a glance</div>
    <h2 class="section-heading">Core interests</h2>
    <div class="interest-grid">
      <div class="interest-card">
        <h3>Diffusion &amp; Flow Matching</h3>
        <p>Generative modeling, stochastic interpolants, and efficient sampling.</p>
      </div>
      <div class="interest-card">
        <h3>Physical AI &amp; World Models</h3>
        <p>Visual world modeling, physical reasoning, and scene dynamics.</p>
      </div>
      <div class="interest-card">
        <h3>3D Vision</h3>
        <p>Geometry-aware learning, reconstruction, rendering, and scene understanding.</p>
      </div>
      <div class="interest-card">
        <h3>Foundation Models</h3>
        <p>Explainable, efficient, and multimodal visual intelligence.</p>
      </div>
    </div>
  </section>

  <section class="home-section home-news">
    <div class="d-flex justify-content-between align-items-end">
      <div>
        <div class="eyebrow">Recent news</div>
        <h2 class="section-heading">Updates</h2>
      </div>
      <a href="{{ '/news/' | relative_url }}">All news <i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <div class="news">
      <div class="table-responsive">
        <table class="table table-sm table-borderless">
          {% assign latest_news = site.news | reverse %}
          {% for item in latest_news limit: 3 %}
            <tr>
              <th scope="row">{{ item.date | date: '%b %Y' }}</th>
              <td>{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</td>
            </tr>
          {% endfor %}
        </table>
      </div>
    </div>
  </section>

  <section class="home-section home-publications">
    <div class="d-flex justify-content-between align-items-end">
      <div>
        <div class="eyebrow">Selected publications</div>
        <h2 class="section-heading">Research works</h2>
      </div>
      <a href="{{ '/publications/' | relative_url }}">All publications <i class="fa-solid fa-arrow-right"></i></a>
    </div>
    {% include selected_papers.liquid %}
  </section>
</div>
